---
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import SeriesOverview from '@/components/SeriesOverview.astro';
import TopicBadge from '@/components/TopicBadge.astro';
import { mdxComponents } from '@/components/mdx/components';
import { postStats, postTitle, type Post, type SeriesData } from '@/lib/posts';
import { format, parseISO } from 'date-fns';
import { render } from 'astro:content';

import '../styles/article.css';

/**
 * Shared by `/writings/[slug]`, `/archive/[slug]` and `/_kitchensink`.
 *
 * All three use the same title size. In the Chakra original they did not — writings used
 * Heading `size="xl"` and archive `size="2xl"` — but that inconsistency was deliberately
 * normalised onto the writings size during the port. See MIGRATION.md Phase 6, finding 3:
 * it is an intentional change on 24 pages, not a porting slip.
 */
interface Props {
    entry: Post;
    series?: SeriesData | null;
    showTopics?: boolean;
}

const { entry, series = null, showTopics = false } = Astro.props;

const { Content } = await render(entry);
const title = postTitle(entry);
const stats = postStats(entry);

// `new Date(...).toISOString()` matches the original exactly: the meta tag carries
// `2022-03-21T00:00:00.000Z`, not the raw `2022-03-21` from the frontmatter.
const publishedISO = new Date(entry.data.publishedAt).toISOString();
---

<DefaultLayout as="article" title={`${title} | Daan Debie`} type="article" date={publishedISO}>
    <h1 class="heading heading-xl">{title}</h1>

    <div class="byline">
        <div class="byline-author">
            <img src="/images/daan.png" alt="Daan Debie" width="24" height="24" class="avatar" />
            <span class="byline-text">
                Daan Debie / {format(parseISO(entry.data.publishedAt), 'MMMM dd, yyyy')}
            </span>
        </div>
        <span class="reading-time">{stats.readingTime}</span>
    </div>

    {
        showTopics && (
            <div class="topics">
                {entry.data.topics?.map((topic) => (
                    <TopicBadge topic={topic} />
                ))}
            </div>
        )
    }

    {series && <SeriesOverview series={series} currentSlug={entry.id} />}

    <div class="article">
        <Content components={mdxComponents} />
    </div>
</DefaultLayout>

<style>
    .byline {
        display: flex;
        flex-direction: column;
        align-items: initial;
        justify-content: space-between;
        width: 100%;
        margin-top: 0.5rem;
    }

    .byline-author {
        display: flex;
        flex-direction: row;
        align-items: center;
    }

    /* Chakra <Text fontSize="sm" mb={0}> — mt from the baseStyle survives, mb is zeroed. */
    .byline-text {
        font-size: var(--text-sm);
        margin-top: 0.5rem;
        margin-bottom: 0;
    }

    .avatar {
        width: 24px;
        height: 24px;
        border-radius: 9999px;
        margin-right: 0.5rem;
    }

    .reading-time {
        font-size: var(--text-sm);
        min-width: 100px;
        margin-top: 0.5rem;
        color: #718096; /* gray.500 — hardcoded in both modes in the original */
    }

    @media (min-width: 30em) {
        .byline {
            flex-direction: row;
            align-items: center;
        }
        .reading-time {
            margin-top: 0;
        }
    }

    .topics {
        display: flex;
        flex-direction: row;
        margin-bottom: 1rem; /* mb={4} */
    }

    /*
     * ⚠️ Flex column, not a plain block, and this is not cosmetic.
     *
     * In the Chakra version the rendered MDX elements were direct children of a
     * `<Flex direction="column" align="flex-start">`, and **flex items do not collapse
     * margins**. As a plain block container every adjacent pair of blocks collapses to
     * max(mb, mt) instead of summing them, losing ~9px at every boundary — about 800px
     * over a long article, which is exactly the height drift the screenshot diff showed.
     *
     * `align-items: flex-start` matches the original too; elements that must span the
     * column (hr, pre, table, aside) set `width: 100%` themselves in article.css, which
     * is precisely why the Chakra components did the same.
     */
    .article {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        width: 100%;
    }
</style>
