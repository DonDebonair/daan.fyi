---
/**
 * TEMPORARY verification route. Renders every entry through the real layout and prose CSS
 * so Phase 5 can be checked against ../baseline/ before the real routes exist.
 *
 * ⚠️ DELETE IN PHASE 6. These are real URLs and would otherwise ship.
 */
import { getCollection, render, type CollectionKey } from 'astro:content';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import SeriesOverview from '@/components/SeriesOverview.astro';
import TopicBadge from '@/components/TopicBadge.astro';
import { mdxComponents } from '@/components/mdx/components';
import { getSeriesData, postStats, postTitle } from '@/lib/posts';
import { format, parseISO } from 'date-fns';

import '../../../styles/article.css';

export async function getStaticPaths() {
    const collections: CollectionKey[] = ['writings', 'archive', 'special'];
    const paths = [];
    for (const collection of collections) {
        for (const entry of await getCollection(collection)) {
            paths.push({ params: { collection, slug: entry.id }, props: { entry } });
        }
    }
    return paths;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const stats = postStats(entry);
const series = entry.data.series
    ? await getSeriesData(entry.collection as 'writings', entry.data.series)
    : null;
---

<DefaultLayout as="article" title={`${postTitle(entry)} | Daan Debie`} type="article">
    <h1 class="post-heading">{postTitle(entry)}</h1>

    <div class="byline">
        <div class="byline-author">
            <img src="/images/daan.png" alt="Daan Debie" width="24" height="24" class="avatar" />
            <span class="text-sm"
                >Daan Debie / {format(parseISO(entry.data.publishedAt), 'MMMM dd, yyyy')}</span
            >
        </div>
        <span class="reading-time">{stats.readingTime}</span>
    </div>

    <div class="topics">
        {entry.data.topics?.map((topic) => <TopicBadge topic={topic} />)}
    </div>

    {series && <SeriesOverview series={series} currentSlug={entry.id} />}

    <div class="article">
        <Content components={mdxComponents} />
    </div>
</DefaultLayout>

<style>
    .post-heading {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: var(--text-4xl);
        line-height: 1.2;
        margin-top: 0.5rem;
        margin-bottom: 1rem;
    }

    @media (min-width: 48em) {
        .post-heading {
            font-size: var(--text-5xl);
            line-height: 1;
        }
    }

    .byline {
        display: flex;
        flex-direction: column;
        align-items: initial;
        justify-content: space-between;
        width: 100%;
        margin-top: 0.5rem;
    }

    .byline-author {
        display: flex;
        flex-direction: row;
        align-items: center;
    }

    .avatar {
        width: 24px;
        height: 24px;
        border-radius: 9999px;
        margin-right: 0.5rem;
    }

    .reading-time {
        font-size: var(--text-sm);
        min-width: 100px;
        margin-top: 0.5rem;
        color: #718096; /* gray.500 — hardcoded in both modes in the original */
    }

    @media (min-width: 30em) {
        .byline {
            flex-direction: row;
            align-items: center;
        }
        .reading-time {
            margin-top: 0;
        }
    }

    .topics {
        display: flex;
        flex-direction: row;
        margin-bottom: 0.25rem;
    }

    .article {
        width: 100%;
    }
</style>
