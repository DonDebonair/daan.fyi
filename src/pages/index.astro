---
// Phase 2 placeholder. Replaced by the real home page in Phase 6.
//
// It exists to prove three things build end to end: the `@/lib/*` path alias, the
// Tailwind 4 pipeline, and `build.format: 'file'` emitting slashless URLs.
import { baseUrl, copyright } from '@/lib/config';

import '../styles/global.css';
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>daan.fyi — scaffold</title>
    </head>
    <body>
        <main class="mx-auto max-w-[800px] p-8">
            <h1 class="text-2xl font-bold">Astro scaffold</h1>
            <p class="mt-4">Site URL resolved from <code>@/lib/config</code>: {baseUrl}</p>
            <p class="mt-2 text-sm">{copyright}</p>
        </main>
    </body>
</html>
