---
// Phase 4 verification page. Replaced by the real home page in Phase 6.
//
// Renders whole posts so the content pipeline can be diffed against ../baseline/html/:
// title-casing, typographic substitutions, heading anchors, Shiki output.
import { getEntry, render } from 'astro:content';
import ColorModeScript from '@/components/ColorModeScript.astro';
import { mdxComponents } from '@/components/mdx/components';

import '../styles/global.css';

const slug = Astro.url.searchParams.get('post') ?? 'iam';
const entry = await getEntry('writings', slug);
const { Content } = await render(entry!);
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{entry!.data.title}</title>
        <ColorModeScript />
    </head>
    <body>
        <main class="mx-auto max-w-[800px] p-8">
            <h1>{entry!.data.title}</h1>
            <Content components={mdxComponents} />
        </main>
    </body>
</html>
