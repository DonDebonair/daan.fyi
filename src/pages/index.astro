---
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import CustomLink from '@/components/CustomLink.astro';
import PostsList from '@/components/PostsList.astro';
import { getSortedPosts } from '@/lib/posts';

/**
 * Feed generation used to happen here, as a side effect of `getStaticProps`. It moves to
 * real endpoints under `src/pages/feeds/` in Phase 7 — the home page no longer has to be
 * built for subscribers to get anything.
 */
const lastPosts = await getSortedPosts('writings', 3);
---

<DefaultLayout title="Home | Daan Debie">
    <h1 class="heading heading-2xl">Howdy! I‘m Daan.</h1>

    <p class="lead">
        I‘m a social code grower, firestarter, software smith, music maniac and general nice guy. I
        work as VP of Engineering at <CustomLink href="https://source.ag" variant="stylish"
            >Source.ag</CustomLink
        > where I help accelerate the global transition to sustainable agriculture with A.I. powered greenhouses.
    </p>
    <p class="lead">This is my little oasis from where I shout into the digital desert.</p>

    <h2 class="heading heading-xl">Recent posts</h2>
    <PostsList posts={lastPosts} />
</DefaultLayout>

<style>
    .lead {
        font-size: var(--text-lg);
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
    }
</style>
