---
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import CustomLink from '@/components/CustomLink.astro';
import PostsList from '@/components/PostsList.astro';
import { getSortedPosts } from '@/lib/posts';

const allPosts = await getSortedPosts('writings');
---

{/* The <title> really is "Blog", not "Writings" — kept as-is. */}
<DefaultLayout title="Blog | Daan Debie">
    <h1 class="heading heading-xl">Writings</h1>
    <p class="intro">
        These are some of my writings. You can also <CustomLink href="/topics" variant="stylish"
            >browse them by topic.</CustomLink
        >
    </p>
    <PostsList posts={allPosts} />
</DefaultLayout>

<style>
    /* No fontSize on the original <Text>, so this inherits the 1rem body size. */
    .intro {
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
    }
</style>
