---
import Icon from '@/components/Icon.astro';
import CustomLink from '@/components/CustomLink.astro';
import { copyright } from '@/lib/config';

const social = [
    { href: 'https://fosstodon.org/@daan', title: 'Mastodon', icon: 'mastodon' },
    { href: 'https://twitter.com/DaanDebie', title: 'Twitter', icon: 'twitter' },
    { href: 'https://github.com/DonDebonair', title: 'GitHub', icon: 'github' },
    { href: 'https://www.linkedin.com/in/danieldebie', title: 'LinkedIn', icon: 'linkedin' },
] as const;
---

<footer class="footer">
    <hr class="footer-rule" />

    <div class="social">
        {
            social.map((item) => (
                <a
                    href={item.href}
                    title={item.title}
                    rel="me noopener noreferrer"
                    target="_blank"
                    class="icon-button"
                    aria-label={item.title}
                >
                    <Icon name={item.icon} />
                </a>
            ))
        }
    </div>

    <div class="links">
        <CustomLink href="/topics" class="footer-link pb-2">All posts by topic</CustomLink>
        <CustomLink href="/archive" class="footer-link">Archive</CustomLink>
    </div>

    <div class="copyright">
        <p class="copyright-text">{copyright}</p>
    </div>
</footer>

<style>
    .footer {
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
    }

    /* Chakra's <Divider>, which uses the default border colour — NOT the same token as
     * the prose <hr>. Identical in light mode, different in dark. */
    .footer-rule {
        opacity: 0.6;
        border: 0;
        border-bottom: 1px solid var(--ui-divider);
        width: 100%;
        margin-bottom: 1rem;
    }

    .social {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
    }

    /* Chakra IconButton at the default size="md": `sizes-10` (2.5rem) square, font-size
     * `md`, no padding. */
    .icon-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 2.5rem;
        min-width: 2.5rem;
        padding: 0;
        color: inherit;
        border-radius: 0.375rem;
        font-size: 1rem;
        line-height: 1.2;
    }

    .icon-button:hover {
        background: var(--ui-inline-code-bg);
    }

    .links {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .footer-link {
        font-size: var(--text-sm);
    }

    .copyright {
        display: flex;
        justify-content: center;
        padding: 2rem;
    }

    /* Chakra <Text> — a <p> carrying the baseStyle's mt/mb of 0.5rem. As a flex item
     * those margins are not collapsed away, so they add 1rem to the page height. */
    .copyright-text {
        font-size: var(--text-sm);
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
    }
</style>
