---
import { format, parseISO } from 'date-fns';
import CustomLink from '@/components/CustomLink.astro';
import TopicBadge from '@/components/TopicBadge.astro';
import { postTitle, type Post } from '@/lib/posts';

/**
 * Replaces the `Post` half of `components/PostsList.tsx` — the full listing with topics
 * and a date. `PostSummaryList.astro` is the compact variant.
 */
interface Props {
    posts: Post[];
    prefix?: string;
}

const { posts, prefix = '/writings' } = Astro.props;
---

{
    posts.map((post) => (
        <div class="post">
            <CustomLink href={`${prefix}/${post.id}`}>
                <h2 class="post-title">{postTitle(post)}</h2>
            </CustomLink>
            <div class="post-topics">
                {post.data.topics?.map((topic) => (
                    <TopicBadge topic={topic} />
                ))}
            </div>
            <span class="post-date">
                {format(parseISO(post.data.publishedAt), 'MMMM dd, yyyy')}
            </span>
        </div>
    ))
}

<style>
    .post {
        display: flex;
        flex-direction: column;
    }

    .post-title {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: var(--text-lg);
        line-height: 1.2;
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .post-topics {
        display: flex;
        flex-direction: row;
        margin-bottom: 0.25rem;
    }

    .post-date {
        font-size: var(--text-sm);
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
    }
</style>
