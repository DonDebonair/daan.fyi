---
import CustomLink from '@/components/CustomLink.astro';
import type { SeriesData } from '@/lib/posts';

interface Props {
    series: SeriesData;
    currentSlug: string;
}

const { series, currentSlug } = Astro.props;
---

<div class="series">
    <div class="series-header">
        <h1 class="series-title">{series.title}</h1>
    </div>
    <ol class="series-list">
        {
            series.posts.map((post, i) => (
                <li class="series-item">
                    <span class:list={['series-circle', post.slug === currentSlug && 'is-current']}>
                        {i + 1}
                    </span>
                    <CustomLink href={`/writings/${post.slug}`}>{post.title}</CustomLink>
                </li>
            ))
        }
    </ol>
</div>

<style>
    .series {
        width: 80%;
        margin: 1rem auto;
        border: 1px solid var(--ui-series-border);
        border-radius: 0.375rem; /* radii.md */
    }

    .series-header {
        width: 100%;
        padding: 1rem;
        border-bottom: 1px solid var(--ui-series-separator);
    }

    .series-title {
        margin: 0;
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: var(--text-xl); /* Chakra Heading size="md" */
        line-height: 1.2;
    }

    .series-list {
        list-style: none;
        margin: 0;
        padding: 0.5rem 1rem; /* px={4} py={2} */
        display: flex;
        flex-direction: column;
        gap: 0.5rem; /* Stack spacing={2} */
    }

    .series-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .series-circle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        width: 40px;
        height: 40px;
        border-radius: 9999px;
        background: var(--ui-series-circle-bg);
        color: var(--ui-series-circle-fg);
    }

    /* The current post's marker keeps the same colours in both modes — that is how the
     * original was written, not an oversight. */
    .series-circle.is-current {
        background: var(--ui-series-circle-current-bg);
        color: var(--ui-series-circle-current-fg);
    }
</style>
