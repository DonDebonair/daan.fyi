---

<svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox={icon.viewBox ?? '0 0 24 24'}
    width="1em"
    height="1em"
    class={className}
    aria-hidden={title ? undefined : 'true'}
    focusable="false"
    role={title ? 'img' : undefined}
    {...icon.attrs}
>
    {title && <title>{title}</title>}
    <Fragment set:html={icon.body} />
</svg>
