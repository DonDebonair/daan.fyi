/**
 * Every icon the site uses, inlined. Replaces @chakra-ui/icons and react-icons — two
 * dependencies and a React runtime for thirteen small SVGs.
 *
 * Path data was extracted verbatim from the packages it replaces, so the shapes are
 * identical to the current site rather than lookalikes:
 *   sun/moon/hamburger/close  → @chakra-ui/icons
 *   rss                       → react-icons/fi
 *   info/success/warning/danger → react-icons/md (Material)
 *   mastodon/twitter/github/linkedin → react-icons/bs + /gr
 *
 * Icons default to 1em so they scale with the surrounding text, matching Chakra's <Icon>.
 */
export type IconName =
    | 'sun'
    | 'moon'
    | 'hamburger'
    | 'close'
    | 'rss'
    | 'info'
    | 'success'
    | 'warning'
    | 'danger'
    | 'mastodon'
    | 'twitter'
    | 'github'
    | 'linkedin';

interface Props {
    name: IconName;
    class?: string;
    title?: string;
}

type IconDef = { viewBox?: string; attrs?: Record<string, string>; body: string };

