---
/**
 * Replaces `components/TopicBadge.tsx` — a Chakra <Badge variant="outline"
 * colorScheme="teal">. The outline variant is an inset box-shadow rather than a border,
 * so the badge does not shift by a pixel on hover when the background fills in.
 */
interface Props {
    topic: string;
}

const { topic } = Astro.props;
---

<a href={`/${topic}`} class="topic-badge">#{topic}</a>

<style>
    .topic-badge {
        display: inline-block;
        margin-right: 0.25rem; /* Chakra mr={1} */
        padding-inline: 0.25rem; /* Chakra px={1} */
        border-radius: 0.125rem; /* radii.sm */
        font-size: 0.6em;
        font-weight: 700;
        text-transform: uppercase;
        white-space: nowrap;
        vertical-align: middle;
        text-decoration: none;
        color: var(--ui-badge-fg);
        box-shadow: inset 0 0 0 1px var(--ui-badge-fg);
    }

    .topic-badge:hover {
        background: var(--ui-badge-hover-bg);
        color: var(--ui-badge-hover-fg);
        opacity: 0.8;
    }
</style>
