{
    "name": "prism-default-light",
    "type": "light",
    "colors": {
        "editor.background": "#F7FAFC",
        "editor.foreground": "#1A202C"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment", "string.comment"],
            "settings": { "foreground": "#708090" }
        },
        {
            "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"],
            "settings": { "foreground": "#999999" }
        },
        {
            "scope": [
                "constant.numeric",
                "constant.language.boolean",
                "constant.other",
                "variable.other.constant",
                "constant.language",
                "entity.name.tag",
                "variable.other.property",
                "meta.object-literal.key",
                "support.type.property-name",
                "markup.deleted"
            ],
            "settings": { "foreground": "#990055" }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "constant.character",
                "support.function.builtin",
                "support.type.builtin",
                "entity.name.selector",
                "entity.other.attribute-name.class",
                "markup.inserted"
            ],
            "settings": { "foreground": "#669900" }
        },
        {
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#669900", "fontStyle": "italic" }
        },
        {
            "scope": [
                "keyword.operator",
                "constant.character.entity",
                "markup.underline.link",
                "string.other.link"
            ],
            "settings": { "foreground": "#9A6E3A" }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "storage.type",
                "storage.modifier",
                "meta.at-rule",
                "meta.at-rule keyword",
                "entity.other.attribute-value"
            ],
            "settings": { "foreground": "#0077AA" }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call.generic",
                "entity.name.type",
                "entity.name.class",
                "entity.name.type.class",
                "support.class"
            ],
            "settings": { "foreground": "#DD4A68" }
        },
        {
            "_comment": "Prism's .token.variable is #e90, but Prism leaves function params untokenised while TextMate scopes them variable.parameter. Mapping `variable` broadly paints every parameter orange. Regex only.",
            "scope": ["string.regexp", "markup.bold"],
            "settings": { "foreground": "#EE9900" }
        },
        {
            "scope": ["entity.name.namespace", "entity.name.scope-resolution"],
            "settings": { "foreground": "#708090" }
        },
        { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
        { "scope": ["markup.bold", "markup.heading"], "settings": { "fontStyle": "bold" } }
    ]
}
